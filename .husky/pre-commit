#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Prevent infinite loop
if [ "$GIT_COMMIT_AMEND" = "true" ]; then
  exit 0
fi

echo "Running Vite build..."

cd vite-project || exit 1

npm run build || {
  echo "❌ Build failed. Commit aborted."
  exit 1
}

cd ..

git add vite-project/dist

echo "✅ Build completed. Staging changes..."

# Amend commit to include the build output
if GIT_COMMIT_AMEND=true git commit --amend --no-edit; then
  echo "✅ Commit amended to include build output."
  exit 0  # exit successfully so Husky doesn't show red
else
  echo "❌ Failed to amend commit."
  exit 1
fi
