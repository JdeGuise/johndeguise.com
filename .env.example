# Copy this file to .env and fill in real values for local development.
# In production (cPanel), set these in the Node.js App panel instead.
# The .env file is gitignored and must never be committed.

SMTP_HOST=johndeguise.com
SMTP_PORT=465
# Set to true only when using port 465 (implicit SSL).
SMTP_SECURE=true
SMTP_USER=admin@johndeguise.com
SMTP_PASS=your-mailbox-password
# Where contact form submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO=john@johndeguise.com

# Leave unset (verification on) when SMTP_HOST matches the mail server's
# TLS certificate. Set to false only if the shared host presents a
# wildcard cert that does not match your chosen SMTP_HOST.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- Logging (Grafana Loki) ---
# Logs always go to stdout (cPanel stderr.log). When LOKI_URL is set they are
# ALSO shipped to a self-hosted Loki instance. Omit LOKI_URL to disable shipping.
LOKI_URL=https://loki-push.rottendegans.com
# Cloudflare Access service token guarding the Loki push endpoint.
LOKI_CF_ACCESS_ID=your-token-id.access
LOKI_CF_ACCESS_SECRET=your-token-secret
# Loki stream labels — identify this app + environment in Grafana.
APP_NAME=johndeguise
APP_ENV=production
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
